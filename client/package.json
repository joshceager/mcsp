{
  "name": "mcsp-client",
  "productName": "MCSP Launcher",
  "version": "0.1.0",
  "description": "Cross-platform Minecraft modpack launcher for self-hosted MCSP backends",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist/main/main.js",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist/main/preload.js",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "npm run build:main && npm run build:preload && npm run build:renderer && electron dist/main/main.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}